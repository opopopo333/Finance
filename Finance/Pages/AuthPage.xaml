<Page x:Class="Finance.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">
    <Grid>
        <!-- Форма входа -->
        <StackPanel x:Name="SPanelLogin" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBoxLogin" MaxLength="50"/>
            <Label Content="Пароль"/>
            <PasswordBox x:Name="PBoxPassword"/>
            <Button Content="Войти" IsDefault="True" Margin="0,15,0,5" Click="BtnLogin_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Регистрация" Click="BtnReg_Click"/>
                <Button Content="Смена пароля" Click="BtnChangePass_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Капча, появляется после 3 неверных попыток -->
        <StackPanel x:Name="SPanelCaptcha" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Label Content="Введите символы с картинки"/>
            <TextBox x:Name="TBoxCaptcha" IsReadOnly="True" ContextMenu="{x:Null}" CommandManager.PreviewExecuted="Captcha_PreviewExecuted"
                     Height="50" FontSize="28" FontStyle="Italic" FontWeight="Bold" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="TBoxCaptchaInput" MaxLength="6" ContextMenu="{x:Null}" CommandManager.PreviewExecuted="Captcha_PreviewExecuted"/>
            <Button Content="Подтвердить" IsDefault="True" Margin="0,15,0,5" Click="BtnCaptcha_Click"/>
        </StackPanel>
    </Grid>
</Page>
