<Page x:Class="Finance.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои операции" Language="ru-RU" IsVisibleChanged="Page_IsVisibleChanged">
    <!-- Language нужен, чтобы суммы в таблице выводились с запятой, как в итогах -->
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск, категория, тип и сортировка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="0,0,10,0">
                <Label Content="Поиск по названию и комментарию"/>
                <TextBox x:Name="TBoxSearch" Width="300" MaxLength="150" TextChanged="TBoxSearch_TextChanged"
                         Tag="Например, Магнит" ToolTip="Таблица фильтруется во время ввода"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Категория"/>
                <ComboBox x:Name="CBoxCategory" Width="180" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Показать операции одной категории"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Тип"/>
                <ComboBox x:Name="CBoxType" Width="120" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Показать только доходы или только расходы">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Доход"/>
                    <ComboBoxItem Content="Расход"/>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox x:Name="CBoxSort" Width="210" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Порядок строк. Можно также щёлкнуть по заголовку столбца">
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Сумма по убыванию"/>
                    <ComboBoxItem Content="Сумма по возрастанию"/>
                    <ComboBoxItem Content="Название А–Я"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Период и сброс фильтров -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Период с" VerticalAlignment="Center"/>
            <DatePicker x:Name="DPickerFrom" Width="140" SelectedDateChanged="Filter_SelectionChanged" ToolTip="Начало периода"/>
            <Label Content="по" VerticalAlignment="Center"/>
            <DatePicker x:Name="DPickerTo" Width="140" SelectedDateChanged="Filter_SelectionChanged" ToolTip="Конец периода"/>
            <Button Content="Сбросить фильтры" Margin="10,0,0,5" Click="BtnReset_Click" ToolTip="Очистить поиск, фильтры и сортировку"/>
        </StackPanel>

        <DataGrid x:Name="DGridOperations" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="160"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Category.Type}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" ToolTip="Изменить эту операцию"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки слева, итоги по операциям в таблице справа -->
        <DockPanel Grid.Row="3">
            <Button Content="Добавить" Margin="0,5,10,5" Click="BtnAdd_Click" ToolTip="Записать новый доход или расход"/>
            <Button Content="Удалить выбранные" Margin="0,5" Click="BtnDelete_Click"
                    ToolTip="Удалить выделенные операции. Несколько строк выделяются с Ctrl или Shift"/>
            <TextBlock x:Name="TBlockTotals" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16"/>
        </DockPanel>
    </Grid>
</Page>
