<Page x:Class="Finance.Pages.AddEditOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление операции">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Пользователь"/>
            <ComboBox x:Name="CBoxUser" DisplayMemberPath="Login"/>
            <Label Content="Категория"/>
            <ComboBox x:Name="CBoxCategory" DisplayMemberPath="Name"/>
            <Label Content="Дата"/>
            <DatePicker x:Name="DPickerDate"/>
            <Label Content="Название"/>
            <TextBox x:Name="TBoxName" MaxLength="150"/>
            <Label Content="Сумма"/>
            <TextBox x:Name="TBoxAmount" MaxLength="11"/>
            <Label Content="Комментарий"/>
            <TextBox x:Name="TBoxComment" MaxLength="500"/>
            <Button Content="Сохранить" IsDefault="True" Margin="0,10,0,5" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
