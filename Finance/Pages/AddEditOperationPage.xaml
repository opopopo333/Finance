<Page x:Class="Finance.Pages.AddEditOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление операции">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="LblUser" Content="Пользователь"/>
            <ComboBox x:Name="CBoxUser" DisplayMemberPath="Login" ToolTip="Чья это операция"/>
            <Label Content="Категория"/>
            <!-- Рядом с названием категории виден её тип; поиск по первым буквам идёт по названию -->
            <ComboBox x:Name="CBoxCategory" TextSearch.TextPath="Name" ToolTip="Категория определяет, доход это или расход">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}"/> (<Run Text="{Binding Type, Mode=OneWay}"/>)
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Label Content="Дата"/>
            <DatePicker x:Name="DPickerDate" ToolTip="Дата операции, не позже сегодняшней"/>
            <Label Content="Название"/>
            <TextBox x:Name="TBoxName" MaxLength="150" Tag="Например, Магнит" ToolTip="Название операции, не длиннее 150 символов"/>
            <Label Content="Сумма"/>
            <TextBox x:Name="TBoxAmount" MaxLength="11" Tag="Например, 1500,50" ToolTip="От 0,01 до 10 000 000: только цифры и одна запятая"/>
            <Label Content="Комментарий"/>
            <TextBox x:Name="TBoxComment" MaxLength="500" Tag="Необязательно" ToolTip="Комментарий к операции, не длиннее 500 символов"/>
            <Button Content="Сохранить" IsDefault="True" Margin="0,10,0,5" Click="BtnSave_Click" ToolTip="Проверить данные и сохранить"/>
        </StackPanel>
    </Grid>
</Page>
