<Page x:Class="Finance.Pages.OperationTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Операции" Language="ru-RU" IsVisibleChanged="Page_IsVisibleChanged">
    <!-- Language нужен, чтобы суммы выводились с запятой -->
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск, фильтр по пользователю и сортировка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="0,0,10,0">
                <Label Content="Поиск по названию и комментарию"/>
                <TextBox x:Name="TBoxSearch" Width="300" MaxLength="150" TextChanged="TBoxSearch_TextChanged"
                         Tag="Например, Магнит" ToolTip="Таблица фильтруется во время ввода"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Пользователь"/>
                <ComboBox x:Name="CBoxUser" Width="180" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Показать операции одного пользователя"/>
            </StackPanel>
            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox x:Name="CBoxSort" Width="210" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Порядок строк. Можно также щёлкнуть по заголовку столбца">
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Сумма по убыванию"/>
                    <ComboBoxItem Content="Сумма по возрастанию"/>
                    <ComboBoxItem Content="Название А–Я"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="DGridOperations" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.Login}" Width="120"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" ToolTip="Изменить эту операцию"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Добавить" Margin="0,5,10,5" Click="BtnAdd_Click" ToolTip="Добавить новую операцию"/>
            <Button Content="Удалить выбранные" Margin="0,5" Click="BtnDelete_Click"
                    ToolTip="Удалить выделенные операции. Несколько строк выделяются с Ctrl или Shift"/>
        </StackPanel>
    </Grid>
</Page>
