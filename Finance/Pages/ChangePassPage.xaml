<Page x:Class="Finance.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBoxLogin" MaxLength="50" Tag="Введите логин" ToolTip="Логин пользователя"/>
            <!-- В Tag полей пароля лежат их подсказки, их прячет обработчик в App.xaml.cs -->
            <Label Content="Текущий пароль"/>
            <Grid>
                <PasswordBox x:Name="PBoxOld" Tag="{Binding ElementName=TBlockOldHint}" ToolTip="Пароль, который действует сейчас"/>
                <TextBlock x:Name="TBlockOldHint" Text="Введите текущий пароль" Style="{DynamicResource HintStyle}"/>
            </Grid>
            <Label Content="Новый пароль"/>
            <Grid>
                <PasswordBox x:Name="PBoxNew" Tag="{Binding ElementName=TBlockNewHint}"
                             ToolTip="Не короче 6 символов, только латиница и цифры, хотя бы одна цифра"/>
                <TextBlock x:Name="TBlockNewHint" Text="Не короче 6 символов" Style="{DynamicResource HintStyle}"/>
            </Grid>
            <Label Content="Подтверждение пароля"/>
            <Grid>
                <PasswordBox x:Name="PBoxConfirm" Tag="{Binding ElementName=TBlockConfirmHint}" ToolTip="Введите новый пароль ещё раз"/>
                <TextBlock x:Name="TBlockConfirmHint" Text="Повторите новый пароль" Style="{DynamicResource HintStyle}"/>
            </Grid>
            <Button Content="Сменить пароль" IsDefault="True" Margin="0,15,0,5" Click="BtnChange_Click" ToolTip="Сохранить новый пароль"/>
        </StackPanel>
    </Grid>
</Page>
