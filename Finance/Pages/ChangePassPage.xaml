<Page x:Class="Finance.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBoxLogin" MaxLength="50"/>
            <Label Content="Текущий пароль"/>
            <PasswordBox x:Name="PBoxOld"/>
            <Label Content="Новый пароль"/>
            <PasswordBox x:Name="PBoxNew"/>
            <Label Content="Подтверждение пароля"/>
            <PasswordBox x:Name="PBoxConfirm"/>
            <Button Content="Сменить пароль" IsDefault="True" Margin="0,15,0,5" Click="BtnChange_Click"/>
        </StackPanel>
    </Grid>
</Page>
