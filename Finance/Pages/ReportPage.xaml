<Page x:Class="Finance.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Отчёты">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Отчёт в Word" Click="BtnWord_Click"/>
            <Button Content="Отчёт в PDF" Click="BtnPdf_Click"/>
            <Button Content="Отчёт в Excel" Click="BtnExcel_Click"/>
        </StackPanel>
    </Grid>
</Page>
