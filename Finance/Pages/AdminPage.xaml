<Page x:Class="Finance.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель администратора">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Пользователи" Click="BtnUsers_Click"/>
            <Button Content="Категории" Click="BtnCategories_Click"/>
            <Button Content="Операции" Click="BtnOperations_Click"/>
            <Button Content="Диаграмма" Click="BtnDiagram_Click"/>
            <Button Content="Отчёты" Click="BtnReports_Click"/>
        </StackPanel>
    </Grid>
</Page>
