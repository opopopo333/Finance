<Page x:Class="Finance.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Категории" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск, фильтр по типу и сортировка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="0,0,10,0">
                <Label Content="Поиск по названию"/>
                <TextBox x:Name="TBoxSearch" Width="300" MaxLength="100" TextChanged="TBoxSearch_TextChanged"
                         Tag="Например, Продукты" ToolTip="Таблица фильтруется во время ввода"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Тип"/>
                <ComboBox x:Name="CBoxType" Width="120" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Показать только категории доходов или расходов">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Доход"/>
                    <ComboBoxItem Content="Расход"/>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox x:Name="CBoxSort" Width="180" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Порядок строк. Можно также щёлкнуть по заголовку столбца">
                    <ComboBoxItem Content="Название А–Я"/>
                    <ComboBoxItem Content="Название Я–А"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="DGridCategories" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" ToolTip="Изменить эту категорию"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Добавить" Margin="0,5,10,5" Click="BtnAdd_Click" ToolTip="Добавить новую категорию"/>
            <Button Content="Удалить выбранные" Margin="0,5" Click="BtnDelete_Click"
                    ToolTip="Удалить выделенные категории. Несколько строк выделяются с Ctrl или Shift"/>
        </StackPanel>
    </Grid>
</Page>
