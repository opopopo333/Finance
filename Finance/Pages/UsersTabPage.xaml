<Page x:Class="Finance.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Пользователи" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск, фильтр по роли и сортировка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="0,0,10,0">
                <Label Content="Поиск по логину и ФИО"/>
                <TextBox x:Name="TBoxSearch" Width="300" MaxLength="150" TextChanged="TBoxSearch_TextChanged"
                         Tag="Например, ivanov" ToolTip="Таблица фильтруется во время ввода"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Роль"/>
                <ComboBox x:Name="CBoxRole" Width="180" SelectionChanged="Filter_SelectionChanged" ToolTip="Показать пользователей одной роли">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Пользователь" Tag="User"/>
                    <ComboBoxItem Content="Администратор" Tag="Admin"/>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox x:Name="CBoxSort" Width="180" SelectionChanged="Filter_SelectionChanged"
                          ToolTip="Порядок строк. Можно также щёлкнуть по заголовку столбца">
                    <ComboBoxItem Content="Логин А–Я"/>
                    <ComboBoxItem Content="Логин Я–А"/>
                    <ComboBoxItem Content="ФИО А–Я"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="DGridUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="BtnEdit_Click" ToolTip="Изменить этого пользователя"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Добавить" Margin="0,5,10,5" Click="BtnAdd_Click" ToolTip="Добавить нового пользователя"/>
            <Button Content="Удалить выбранные" Margin="0,5" Click="BtnDelete_Click"
                    ToolTip="Удалить выделенных пользователей. Несколько строк выделяются с Ctrl или Shift"/>
        </StackPanel>
    </Grid>
</Page>
