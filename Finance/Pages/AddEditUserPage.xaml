<Page x:Class="Finance.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление пользователя">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBoxLogin" MaxLength="50"/>
            <Label x:Name="LblPassword" Content="Пароль"/>
            <PasswordBox x:Name="PBoxPassword"/>
            <Label Content="ФИО"/>
            <TextBox x:Name="TBoxFIO" MaxLength="150"/>
            <Label Content="Роль"/>
            <!-- В Tag лежит значение для столбца Users.Role -->
            <ComboBox x:Name="CBoxRole" SelectedIndex="0">
                <ComboBoxItem Content="Пользователь" Tag="User"/>
                <ComboBoxItem Content="Администратор" Tag="Admin"/>
            </ComboBox>
            <Button Content="Сохранить" IsDefault="True" Margin="0,15,0,5" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
