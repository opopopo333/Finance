<Page x:Class="Finance.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление пользователя">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBoxLogin" MaxLength="50" Tag="Латиница, цифры и _"
                     ToolTip="От 3 до 50 символов: латинские буквы, цифры и _"/>
            <Label x:Name="LblPassword" Content="Пароль"/>
            <!-- В Tag поля пароля лежит его подсказка, её прячет обработчик в App.xaml.cs -->
            <Grid>
                <PasswordBox x:Name="PBoxPassword" Tag="{Binding ElementName=TBlockPasswordHint}"
                             ToolTip="Не короче 6 символов, только латиница и цифры, хотя бы одна цифра"/>
                <TextBlock x:Name="TBlockPasswordHint" Text="Не короче 6 символов" Style="{DynamicResource HintStyle}"/>
            </Grid>
            <Label Content="ФИО"/>
            <TextBox x:Name="TBoxFIO" MaxLength="150" Tag="Иванов Иван Иванович" ToolTip="Русские буквы, пробел и дефис"/>
            <Label Content="Роль"/>
            <!-- В Tag лежит значение для столбца Users.Role -->
            <ComboBox x:Name="CBoxRole" SelectedIndex="0" ToolTip="Пользователь видит только свои операции, администратор управляет всеми данными">
                <ComboBoxItem Content="Пользователь" Tag="User"/>
                <ComboBoxItem Content="Администратор" Tag="Admin"/>
            </ComboBox>
            <Button Content="Сохранить" IsDefault="True" Margin="0,15,0,5" Click="BtnSave_Click" ToolTip="Проверить данные и сохранить"/>
        </StackPanel>
    </Grid>
</Page>
