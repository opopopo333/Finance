<Page x:Class="Finance.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Диаграмма">
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выбор пользователя, вида диаграммы и типа операций -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="0,0,10,0">
                <Label Content="Пользователь"/>
                <ComboBox x:Name="CBoxUser" Width="300" DisplayMemberPath="FIO" SelectionChanged="Chart_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <Label Content="Вид диаграммы"/>
                <ComboBox x:Name="CBoxChartType" Width="180" SelectionChanged="Chart_SelectionChanged"/>
            </StackPanel>
            <StackPanel>
                <Label Content="Тип операций"/>
                <ComboBox x:Name="CBoxType" Width="120" SelectionChanged="Chart_SelectionChanged">
                    <ComboBoxItem Content="Доход"/>
                    <ComboBoxItem Content="Расход"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Chart из Windows Forms вставлен в WPF через WindowsFormsHost -->
        <WindowsFormsHost Grid.Row="1" Margin="0,5,0,10">
            <charts:Chart x:Name="ChartOperations"/>
        </WindowsFormsHost>
    </Grid>
</Page>
