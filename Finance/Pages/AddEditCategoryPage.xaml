<Page x:Class="Finance.Pages.AddEditCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Finance.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление категории">
    <Grid>
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Название"/>
            <TextBox x:Name="TBoxName" MaxLength="100"/>
            <Label Content="Тип"/>
            <ComboBox x:Name="CBoxType" SelectedIndex="0">
                <ComboBoxItem Content="Доход"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>
            <Button Content="Сохранить" IsDefault="True" Margin="0,15,0,5" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
